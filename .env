# Auto-generated .env for local development
# WARNING: Do NOT commit this file to version control.

# Groq LLM key — pasted per user request
GROQ_API_KEY=replace with your api
GROQ_MODEL=llama3-70b-8192
GROQ_TEMPERATURE=0.0
GROQ_MAX_TOKENS=1024

# NCBI Entrez
ENTREZ_EMAIL=your_email@example.com

# FastAPI server
API_HOST=0.0.0.0
API_PORT=8001

# UI CORS
UI_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# MLflow (optional)
MLFLOW_TRACKING_URI=http://localhost:5000

# Other defaults
N_TOP_GENES=500
RANDOM_SEED=42
